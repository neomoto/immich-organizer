# Copy into your private deployment environment. Never commit actual values.
ORGANIZER_VERSION=0.1.0-alpha.2
ORGANIZER_SECRET=
ORGANIZER_DB_PASSWORD=
AI_PROVIDER=zai-coding-plan
# One administrator-owned key shared by text Coding Plan calls and local Vision MCP.
Z_AI_API_KEY=
KEEPER_BASE_URL=https://api.z.ai/api/coding/paas/v4
KEEPER_MODEL=glm-5.3
# Direct standard-API mode remains available with these separate settings:
# AI_PROVIDER=direct
# VISION_BASE_URL=https://api.z.ai/api/paas/v4
# VISION_MODEL=glm-5v-turbo
# VISION_API_KEY=
# Keeper housekeeping runs once per day at 03:00 in this NAS timezone by default.
TZ=UTC
